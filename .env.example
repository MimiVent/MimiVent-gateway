MQTT_USERNAME=mimivent
MQTT_PASSWORD=replace-with-a-random-password-at-least-24-characters
GATEWAY_UID=1000
GATEWAY_GID=1000
NAS_IP=192.168.1.20
# HTTP 首配页端口；只提供二维码/连接串页面，不提供控制 API。
HTTP_SETUP_PORT=18080
# NAS 主机侧 NTP 健康提供器应每 10 秒原子更新此目录下的 time-health.json。
HOST_TIME_SYNC_HEALTH_DIR=./data/time-health
